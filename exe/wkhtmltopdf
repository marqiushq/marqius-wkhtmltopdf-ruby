#!/usr/bin/env ruby
# frozen_string_literal: true

# wkhtmltopdf, for wicked_pdf, PDFKit and the other libraries that look for it with Bundler or on
# the PATH, as they found wkhtmltopdf-binary's: it starts marqius-wkhtmltopdf, which this gem carries.
require_relative "../lib/marqius_wkhtmltopdf"

begin
  program = MarqiusWkhtmltopdf.program
rescue MarqiusWkhtmltopdf::Error => e
  abort e.message
end
exec program, "wkhtmltopdf", *ARGV
